# ------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
!*.env.example

# SSL Certificates & Private Keys
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
