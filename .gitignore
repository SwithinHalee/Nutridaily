backend/dist/
coverage/
backend/coverage/

# Next.js Frontend
.next/
frontend/.next/
.next-dev/
frontend/.next-dev/
out/
frontend/out/
build/

# TypeScript Caches
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
backend/tsconfig.tsbuildinfo
next-env.d.ts

# ------------------------------------------
